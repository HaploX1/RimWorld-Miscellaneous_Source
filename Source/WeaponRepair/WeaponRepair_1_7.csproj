<Project Sdk="Microsoft.NET.Sdk">

  <!-- RimWorld 1.7 port: 1.7 runs on .NET 10 (CoreCLR) with Unity reduced to UnityStubs.dll,
       so the legacy net472 WeaponRepair.csproj cannot reference the game assemblies.
       The legacy csproj stays untouched for the <= 1.6 builds.
       Behaviour change for 1.7: weapons repair up to 100% of MaxHitPoints (was 95%). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WeaponRepair</AssemblyName>
    <RootNamespace>WeaponRepair</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\1.7\</OutputPath>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <NoWarn>$(NoWarn);CS0414;CS0649;CS0169</NoWarn>
    <!-- Explicit compile list (legacy parity); disable the SDK default glob. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\_RimWorldDLLs\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>..\_RimWorldDLLs\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Same compile list as the legacy WeaponRepair.csproj (3 sources; AssemblyInfo is generated by
       the SDK). The *WithThings trio is not in the legacy list and stays uncompiled. -->
  <ItemGroup>
    <Compile Include="CompProperties_WeaponRepairTwo2One.cs" />
    <Compile Include="CompWeaponRepairTwo2One.cs" />
    <Compile Include="JobDriver_WeaponRepairTwo2One.cs" />
  </ItemGroup>

</Project>
