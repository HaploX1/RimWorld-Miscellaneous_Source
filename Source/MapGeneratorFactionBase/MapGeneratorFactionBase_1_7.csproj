<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MapGeneratorFactionBase</AssemblyName>
    <RootNamespace>MapGenerator</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <OutputPath>bin\1.7\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The legacy AssemblyInfo.cs belongs to the <=1.6 build; the 1.7 build
         generates its assembly attributes from this project file. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <FileVersion>1.7.0.0</FileVersion>
    <Version>1.7.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BlueprintHandler.cs" />
    <Compile Include="Genstep_CreateBlueprintBase.cs" />
    <Compile Include="MapGeneratorBaseBlueprintDef.cs" />
    <Compile Include="RectTrigger_UnfogBaseArea.cs" />
    <Compile Include="Reflection_CallMethod.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\_RimWorldDLLs\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>..\_RimWorldDLLs\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>..\_RimWorldDLLs\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith.UnityCompat">
      <HintPath>..\_RimWorldDLLs\Waylith.UnityCompat.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
