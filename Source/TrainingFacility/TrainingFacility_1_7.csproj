<Project Sdk="Microsoft.NET.Sdk">

  <!-- RimWorld 1.7 port: 1.7 runs on .NET 10 (CoreCLR) with Unity reduced to UnityStubs.dll,
       so the legacy net472 TrainingFacility.csproj cannot reference the game assemblies.
       Waylith.dll + Waylith.UnityCompat.dll are required on top of Assembly-CSharp/UnityStubs
       because UnityEngine.Material (Graphic_RandomMote.DrawWorker) lives there since 1.7.
       The legacy csproj stays untouched for the <= 1.6 builds. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TrainingFacility</AssemblyName>
    <RootNamespace>TrainingFacility</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\1.7\</OutputPath>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <NoWarn>$(NoWarn);CS0414;CS0649;CS0169</NoWarn>
    <!-- Explicit compile list (legacy parity); disable the SDK default glob. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\_RimWorldDLLs\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>..\_RimWorldDLLs\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>..\_RimWorldDLLs\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith.UnityCompat">
      <HintPath>..\_RimWorldDLLs\Waylith.UnityCompat.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Same compile list as the legacy TrainingFacility.csproj (20 sources; AssemblyInfo is
       generated by the SDK, so the old Properties\AssemblyInfo.cs is not compiled). -->
  <ItemGroup>
    <Compile Include="Building_Archery.cs" />
    <Compile Include="Building_MartialArtsTarget.cs" />
    <Compile Include="Building_ShootingRange.cs" />
    <Compile Include="Graphic_RandomMote.cs" />
    <Compile Include="JobDriver_Archery.cs" />
    <Compile Include="JobDriver_MartialArtsTarget.cs" />
    <Compile Include="JobDriver_MartialArtsTarget_NonJoy.cs" />
    <Compile Include="JobDriver_ShootingRange.cs" />
    <Compile Include="JobDriver_ShootingRange_NonJoy.cs" />
    <Compile Include="JoyGiver_PracticeMartialArts.cs" />
    <Compile Include="JoyGiver_PracticeShooting.cs" />
    <Compile Include="PlaceWorker_MartialArtsTarget.cs" />
    <Compile Include="PlaceWorker_ShootingRange.cs" />
    <Compile Include="TrainingFacility_Mod.cs" />
    <Compile Include="TrainingFacility_ModSettings.cs" />
    <Compile Include="Utility_Hungry.cs" />
    <Compile Include="Utility_MaxAllowedTrainingLevel.cs" />
    <Compile Include="Utility_PositionFinder.cs" />
    <Compile Include="Utility_Tired.cs" />
    <Compile Include="WorkGiver_Training.cs" />
  </ItemGroup>

</Project>
