    <Compile Include="X2_JobDriver_RepairDamagedRobot.cs" />
    <Compile Include="X2_JobDriver_RepairStationRobot.cs" />
    <Compile Include="X2_AIRobot_Pawn_WorkSettings.cs" />
    <Compile Include="X2_AIRobot_disabled.cs" />
